# Base URL of the backend API, /api/v1 included, without trailing slash
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Address of the published site, no trailing slash: canonical links, link previews, sitemap. Empty: the workers.dev address in vite.config.ts
VITE_SITE_URL=
# Google Tag Manager container (GTM-XXXXXXX). Empty: GTM is not loaded
VITE_GTM_ID=
# Images served from another host (CDN). Empty: VITE_API_BASE_URL without /api/v1, where the backend serves them
VITE_ASSETS_BASE_URL=
# true: the card catalog comes from src/shared/api/mock/cards.json instead of the API, while the backend has no cards
VITE_MOCK_CARDS=
